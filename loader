if not game:IsLoaded() then
    game.Loaded:Wait()
end

local env = (getgenv and getgenv()) or _G
if env.__REZEHUB_LOADING then return end
env.__REZEHUB_LOADING = true

local RAP = "https://raw.githubusercontent.com/jr0nzz/zanjihub/refs/heads/main/rideapet.lua"

local ok, err = pcall(function()
    local source
    for i = 1, 3 do
        local success, result = pcall(game.HttpGet, game, RAP, true)
        if success and type(result) == "string" and #result > 0 then
            source = result
            break
        end
        task.wait(i * 0.5)
    end

    if not source then error("Failed to download script") end

    local chunk, compileError = loadstring(source)
    if not chunk then error(compileError) end
    chunk()
end)

env.__REZEHUB_LOADING = nil
if not ok then warn("[REZEHUB] " .. tostring(err)) end
